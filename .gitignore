# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Test / Benchmark / Temporary files
frames/
scratch/
test_frames*/
bench_frames*/
perf_output.*
ci_frames_data.js
*.mcpack
build/
dist/
*.spec

# Benchmark-generated PNG images (never commit large test assets)
