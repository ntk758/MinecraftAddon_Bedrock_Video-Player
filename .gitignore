**/step*_test_frames/
**/test_frames_bench/

# IDE & Editor temporary files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Preserve essential addon files
!manifest.json
!main.js
!pack_icon.png
